# ============================================================
# Umira AI — FRONTEND (Next.js)
#   cp .env.example .env.local    (dibaca saat `npm run dev` dan `npm run build`)
# PENTING: nilai di bawah "dibakar" saat build → setelah mengubah, jalankan ulang `npm run build`.
# ============================================================

# --- Pilih SATU cara terhubung ke backend ---

# (A) Langsung ke backend di domain lain (mis. api.umira.id).
#     Backend wajib: CORS_ORIGINS=<URL frontend ini>. Bila beda "site" (bukan subdomain yang sama),
#     backend juga butuh COOKIE_SAMESITE=none + HTTPS.
NEXT_PUBLIC_API_URL=

# (B) Lewat proxy Next.js (dipakai bila NEXT_PUBLIC_API_URL kosong) — tanpa CORS.
#     Alamat backend yang bisa dijangkau dari SERVER frontend.
API_PROXY_TARGET=http://localhost:4000

# Port/host server production diatur lewat environment saat start, mis.:
#   PORT=3000 WEB_HOST=127.0.0.1 npm start
